<Window x:Class="Lagerverwaltung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lagerverwaltung" Width="1120" Height="760" MinWidth="840" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="#EEF3F3"
        Language="de-DE" Loaded="OnLoad">
  <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#163A42" Padding="26,17">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="Refresh" VerticalAlignment="Center" Click="RefreshClick">Aktualisieren</Button>
        <StackPanel>
          <TextBlock Text="Lagerverwaltung" Foreground="White" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock x:Name="Endpoint" Foreground="#C8E5E3" Margin="0,2,12,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,20,24,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Artikel und Bestand" FontWeight="SemiBold" FontSize="20"/>
          <DockPanel Grid.Row="1" Margin="0,14,0,14" LastChildFill="True">
            <Label Target="{Binding ElementName=Search}" Padding="0,5,10,0">_Suche</Label>
            <TextBox x:Name="Search" Height="34" MaxLength="120" AutomationProperties.Name="Artikel nach Name oder Nummer suchen" TextChanged="SearchChanged"/>
          </DockPanel>
          <DataGrid x:Name="Products" Grid.Row="2" SelectionChanged="ProductChanged" AutomationProperties.Name="Artikelliste">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers><DataTrigger Binding="{Binding LowStock}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Art.-Nr." Binding="{Binding Sku}" Width="85"/>
              <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="*" MinWidth="100"/>
              <DataGridTextColumn Header="Bestand" Binding="{Binding Stock}" Width="67"/>
              <DataGridTextColumn Header="Min." Binding="{Binding Minimum}" Width="49"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" CornerRadius="8">
          <StackPanel>
            <TextBlock Text="Bestand buchen" FontWeight="SemiBold" FontSize="20"/>
            <TextBlock x:Name="SelectedLabel" Margin="0,5,0,15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Grid x:Name="BookingFields">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <Label Target="{Binding ElementName=Direction}" Padding="0,0,0,4">_Vorgang</Label>
                <ComboBox x:Name="Direction" Height="34" SelectedIndex="0">
                  <ComboBoxItem>Wareneingang</ComboBoxItem><ComboBoxItem>Warenausgang</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <Label Target="{Binding ElementName=Quantity}" Padding="0,0,0,4">_Menge</Label>
                <TextBox x:Name="Quantity" Text="1" Height="34" MaxLength="7"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Label Target="{Binding ElementName=Note}" Padding="0,0,0,4">_Notiz (optional)</Label>
                <TextBox x:Name="Note" Height="34" MaxLength="160"/>
              </StackPanel>
            </Grid>
            <DockPanel Margin="0,14,0,0" LastChildFill="False">
              <Button x:Name="Book" Click="BookClick" Background="#DCEFEA" BorderBrush="#A9CFC3" DockPanel.Dock="Left">Buchung speichern</Button>
              <Button x:Name="Retry" Click="RetryClick" Visibility="Collapsed" Margin="8,0,0,0" DockPanel.Dock="Left">Buchung erneut prüfen</Button>
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="0,16,0,0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" CornerRadius="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Letzte Bewegungen" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,12"/>
            <DataGrid x:Name="History" AutomationProperties.Name="Letzte Bestandsbewegungen">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding LocalTime, StringFormat=dd.MM.yy HH:mm}" Width="110"/>
                <DataGridTextColumn Header="Menge" Binding="{Binding Delta, StringFormat={}{0:+0;-0;0}}" Width="60"/>
                <DataGridTextColumn Header="Danach" Binding="{Binding StockAfter}" Width="62"/>
                <DataGridTextColumn Header="Notiz" Binding="{Binding Note}" Width="*" MinWidth="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#E0ECEB" Padding="24,11" MinHeight="47">
      <TextBlock x:Name="Status" Text="Verbindung wird aufgebaut …" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
